# ============================================================================
#  ENVIRONMENT VARIABLES
#  Copy this file to `.env.local` and fill in your own Supabase keys.
#
#    cp .env.example .env.local
#
#  Where to find these:
#    Supabase Dashboard → Project Settings → API
# ============================================================================

# ---- Vite build (this repo) -------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Next.js build (docs/nextjs port) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ============================================================================
#  NOTE: If you leave these blank the app still runs 100% offline using a
#  built-in localStorage "Demo Mode" backend. Great for local dev + demos.
# ============================================================================
